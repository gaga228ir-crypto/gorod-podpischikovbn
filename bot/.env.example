# Скопируй в .env и заполни. Файл .env никому не показывай и не заливай на GitHub.
BOT_TOKEN=
ADMIN_IDS=6534979716
# База: оставь две строки ниже ПУСТЫМИ — бот хранит всё в файле gorod.db (без VPN).
# Или впиши Supabase (в РФ без VPN он может не открываться).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Адрес сайта-города (лучше SourceCraft — открывается в РФ без VPN)
SITE_URL=https://gorod.sourcecraft.site/gorod/
# Ссылка на закреплённый ролик «Почты города», где пишут коды
POCHTA_URL=https://www.tiktok.com/@pochta.goroda/photo/7706934560818318605
CHANNEL_URL=
TIKTOK_URL=https://www.tiktok.com/@eben51041
CUSTOM_PRICE=0
# Дом по описанию (нейросеть на этом ПК через Ollama)
AI_PRICE=15
OLLAMA_MODEL=qwen2.5:7b
# ТГ-канал: @username (бот должен быть админом канала) — декор только подписчикам канала
CHANNEL_ID=
# Чат жителей (ссылка-приглашение) и сколько друзей = бесплатный дом по описанию
CHAT_URL=https://t.me/+URDD6hcKo4ZlOTMy
REF_GOAL=3
# id чата жителей (-100…): добавь бота в чат и напиши там /chatid. Нужен, чтобы проверять кандидатов в мэры
CHAT_ID=
# Сколько дней идут выборы мэра (/mayor_start)
MAYOR_DAYS=7
# Клад дня: соль — как KLAD_SALT в index.html; сколько призов в день
KLAD_SALT=gorod-klad-v1
KLAD_LIMIT=5
# Токен GitHub (fine-grained, только этот репозиторий, Contents: Read and write) —
# бот выкладывает особые дома в recipes.json, и их видно на сайте без VPN
GITHUB_TOKEN=
GITHUB_REPO=gaga228ir-crypto/gorod-podpischikovbn
# Автообновление подписчиков: cookie sessionid из TikTok (браузер на ПК, где ты залогинен в @eben51041).
# Это ключ от твоего аккаунта — только сюда, никому не отправляй. Пусто — подписчиков обновляешь вручную.
TIKTOK_SESSIONID=
# Как часто собирать подписчиков (минут) и как часто бот перезапускается за обновлением (часов)
SUBS_EVERY_MIN=120
RESTART_HOURS=12
